 "597202": [
  {
   "old": "<img alt=\"The citric acid cycle drawn as a ring of eight intermediates: oxaloacetate plus acetyl-CoA form citrate (citrate synthase), citrate isomerizes to isocitrate (aconitase), isocitrate is oxidatively decarboxylated to alpha-ketoglutarate (NADH and CO2), alpha-ketoglutarate to succinyl-CoA (NADH and CO2), succinyl-CoA to succinate with GTP formation, succinate to fumarate with FADH2, fumarate hydrated to malate, and malate oxidized to oxaloacetate with NADH. One turn yields 3 NADH, 1 FADH2, 1 GTP and 2 CO2.\" width=\"760\" style=\"display:block;margin:0;max-width:100%;height:auto;\" src=\"https://itsdrdan.github.io/textbook/figures/print/fig-p597202-1-1.svg\" /><img alt=\"\" width=\"760\" style=\"display:block;margin:0;max-width:100%;height:auto;\" src=\"https://itsdrdan.github.io/textbook/figures/print/fig-p597202-1-2.svg\" />",
   "new": "<img alt=\"The citric acid cycle drawn as a ring of eight intermediates: oxaloacetate plus acetyl-CoA form citrate (citrate synthase), citrate isomerizes to isocitrate (aconitase), isocitrate is oxidatively decarboxylated to alpha-ketoglutarate (NADH and CO2), alpha-ketoglutarate to succinyl-CoA (NADH and CO2), succinyl-CoA to succinate with GTP formation, succinate to fumarate with FADH2, fumarate hydrated to malate, and malate oxidized to oxaloacetate with NADH. One turn yields 3 NADH, 1 FADH2, 1 GTP and 2 CO2.\" width=\"760\" style=\"display:block;margin:0;max-width:100%;height:auto;\" src=\"https://itsdrdan.github.io/textbook/figures/print/fig-p597202-1-v2-1.svg\" /><img alt=\"\" width=\"760\" style=\"display:block;margin:0;max-width:100%;height:auto;\" src=\"https://itsdrdan.github.io/textbook/figures/print/fig-p597202-1-v2-2.svg\" /><img alt=\"\" width=\"760\" style=\"display:block;margin:0;max-width:100%;height:auto;\" src=\"https://itsdrdan.github.io/textbook/figures/print/fig-p597202-1-v2-3.svg\" />",
   "count": 1,
