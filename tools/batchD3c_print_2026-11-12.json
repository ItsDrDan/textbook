 "597214": [
  {
   "old": "<img src=\"https://itsdrdan.github.io/textbook/figures/print/fa_synthesis-1.svg\" alt=\"Fatty acid synthesis cycle. Acetyl CoA is carboxylated, using ATP, to malonyl CoA; acetyl and malonyl groups are loaded onto acyl carrier protein (ACP). Step 1, condensation with loss of CO2, gives acetoacetyl ACP (4 carbons). Step 2, reduction by NADPH, gives 3-hydroxybutyryl ACP. Step 3, dehydration, gives crotonyl ACP with a C=C. Step 4, reduction by NADPH, gives butyryl ACP. Butyryl ACP takes another malonyl ACP for the next turn; after 7 turns the chain is palmitate, 16 carbons.\" style=\"display:block;margin:0;width:100%;height:auto;max-width:900px\" loading=\"lazy\" /><img src=\"https://itsdrdan.github.io/textbook/figures/print/fa_synthesis-2.svg\" alt=\"\" style=\"display:block;margin:0;width:100%;height:auto;max-width:900px\" loading=\"lazy\" />",
   "new": "<img src=\"https://itsdrdan.github.io/textbook/figures/print/fa_synthesis-v2-1.svg\" alt=\"Fatty acid synthesis cycle. Acetyl CoA is carboxylated, using ATP, to malonyl CoA; acetyl and malonyl groups are loaded onto acyl carrier protein (ACP). Step 1, condensation with loss of CO2, gives acetoacetyl ACP (4 carbons). Step 2, reduction by NADPH, gives 3-hydroxybutyryl ACP. Step 3, dehydration, gives crotonyl ACP with a C=C. Step 4, reduction by NADPH, gives butyryl ACP. Butyryl ACP takes another malonyl ACP for the next turn; after 7 turns the chain is palmitate, 16 carbons.\" style=\"display:block;margin:0;width:100%;height:auto;max-width:900px\" loading=\"lazy\" /><img src=\"https://itsdrdan.github.io/textbook/figures/print/fa_synthesis-v2-2.svg\" alt=\"\" style=\"display:block;margin:0;width:100%;height:auto;max-width:900px\" loading=\"lazy\" />",
