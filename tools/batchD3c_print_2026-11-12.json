 "597194": [
  {
   "old": "<img alt=\"Entry points of other monosaccharides into glycolysis. Galactose is phosphorylated by galactokinase to galactose-1-phosphate, converted through UDP-galactose and UDP-glucose (using an epimerase) to glucose-1-phosphate, then by phosphoglucomutase to glucose-6-phosphate, where it joins glycolysis. Mannose is phosphorylated by hexokinase to mannose-6-phosphate and isomerized to fructose-6-phosphate. In muscle, fructose is phosphorylated by hexokinase to fructose-6-phosphate. In the liver, fructose is phosphorylated by fructokinase to fructose-1-phosphate, which aldolase B splits into dihydroxyacetone phosphate and glyceraldehyde; glyceraldehyde is phosphorylated to glyceraldehyde-3-phosphate. The liver route enters below phosphofructokinase-1, the main control point.\" width=\"760\" style=\"display:block;margin:0;max-width:100%;height:auto;\" src=\"https://itsdrdan.github.io/textbook/figures/print/fig-p597194-1-1.svg\" /><img alt=\"\" width=\"760\" style=\"display:block;margin:0;max-width:100%;height:auto;\" src=\"https://itsdrdan.github.io/textbook/figures/print/fig-p597194-1-2.svg\" />",
   "new": "<img alt=\"Entry points of other monosaccharides into glycolysis. Galactose is phosphorylated by galactokinase to galactose-1-phosphate, converted through UDP-galactose and UDP-glucose (using an epimerase) to glucose-1-phosphate, then by phosphoglucomutase to glucose-6-phosphate, where it joins glycolysis. Mannose is phosphorylated by hexokinase to mannose-6-phosphate and isomerized to fructose-6-phosphate. In muscle, fructose is phosphorylated by hexokinase to fructose-6-phosphate. In the liver, fructose is phosphorylated by fructokinase to fructose-1-phosphate, which aldolase B splits into dihydroxyacetone phosphate and glyceraldehyde; glyceraldehyde is phosphorylated to glyceraldehyde-3-phosphate. The liver route enters below phosphofructokinase-1, the main control point.\" width=\"760\" style=\"display:block;margin:0;max-width:100%;height:auto;\" src=\"https://itsdrdan.github.io/textbook/figures/print/fig-p597194-1-v2-1.svg\" /><img alt=\"\" width=\"760\" style=\"display:block;margin:0;max-width:100%;height:auto;\" src=\"https://itsdrdan.github.io/textbook/figures/print/fig-p597194-1-v2-2.svg\" /><img alt=\"\" width=\"760\" style=\"display:block;margin:0;max-width:100%;height:auto;\" src=\"https://itsdrdan.github.io/textbook/figures/print/fig-p597194-1-v2-3.svg\" />",
   "count": 1,
   "note": "fig-p597194-1.svg: 3 strips, uniform print width 522 pt"
  }
