   "old": "<img src=\"https://itsdrdan.github.io/textbook/figures/pathways/glycolysis/print/full-payoff-1.svg\" alt=\"Glycolysis part 2, steps 6 to 10 with structures, each happening twice per glucose: glyceraldehyde 3-phosphate is oxidized by NAD+ and gains a phosphate, the phosphate is passed to ADP to make ATP, the phosphate moves from carbon 3 to carbon 2, water is removed to make phosphoenolpyruvate, and its phosphate goes to ADP to make ATP and pyruvate.\" width=\"600\" style=\"display:block;max-width:100%;height:auto;margin:0\" /><img src=\"https://itsdrdan.github.io/textbook/figures/pathways/glycolysis/print/full-payoff-2.svg\" alt=\"\" width=\"600\" style=\"display:block;max-width:100%;height:auto;margin:0\" /><img src=\"https://itsdrdan.github.io/textbook/figures/pathways/glycolysis/print/full-payoff-3.svg\" alt=\"\" width=\"600\" style=\"display:block;max-width:100%;height:auto;margin:0\" /><img src=\"https://itsdrdan.github.io/textbook/figures/pathways/glycolysis/print/full-payoff-4.svg\" alt=\"\" width=\"600\" style=\"display:block;max-width:100%;height:auto;margin:0\" /><img src=\"https://itsdrdan.github.io/textbook/figures/pathways/glycolysis/print/full-payoff-5.svg\" alt=\"\" width=\"600\" style=\"display:block;max-width:100%;height:auto;margin:0\" /><img src=\"https://itsdrdan.github.io/textbook/figures/pathways/glycolysis/print/full-payoff-6.svg\" alt=\"\" width=\"600\" style=\"display:block;max-width:100%;height:auto;margin:0\" />",
