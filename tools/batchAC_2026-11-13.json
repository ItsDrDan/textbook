    "old": "<figure class=\"figure\" style=\"margin:1em 0\"><a style=\"text-decoration:underline\" href=\"https://itsdrdan.github.io/textbook/figures/pathways/nonessential_aa.svg\" target=\"_blank\" rel=\"noopener\"><img src=\"https://itsdrdan.github.io/textbook/figures/print/nonessential_aa-v2-1.svg\" alt=\"Sources of the nonessential amino acids. 3-Phosphoglycerate from glycolysis gives serine, and serine gives glycine and cysteine, whose sulfur comes from methionine. Pyruvate gives alanine by transamination (ALT). Oxaloacetate from the citric acid cycle gives aspartate by transamination (AST), and aspartate gives asparagine by adding an amide nitrogen. Alpha-ketoglutarate gives glutamate by transamination, and glutamate gives glutamine, proline and arginine (labeled conditionally essential). The essential amino acid phenylalanine gives tyrosine by adding an OH group, using O2 and NADPH.\" style=\"display:block;margin:0;width:100%;height:auto;max-width:900px\" loading=\"lazy\" /><img src=\"https://itsdrdan.github.io/textbook/figures/print/nonessential_aa-v2-2.svg\" alt=\"\" style=\"display:block;margin:0;width:100%;height:auto;max-width:900px\" loading=\"lazy\" /><img src=\"https://itsdrdan.github.io/textbook/figures/print/nonessential_aa-v2-3.svg\" alt=\"\" style=\"display:block;margin:0;width:100%;height:auto;max-width:900px\" loading=\"lazy\" /></a>",
