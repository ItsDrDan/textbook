 <strong>Met (Start)</strong></td><td>ACG Thr</td><td>AAG Lys</td><td>AGG Arg</td><th scope=\"row\">G</th></tr>\n<tr><th scope=\"row\" rowspan=\"4\">G</th><td>GUU Val</td><td>GCU Ala</td><td>GAU Asp</td><td>GGU Gly</td><th scope=\"row\">U</th></tr>\n<tr><td>GUC Val</td><td>GCC Ala</td><td>GAC Asp</td><td>GGC Gly</td><th scope=\"row\">C</th></tr>\n<tr><td>GUA Val</td><td>GCA Ala</td><td>GAA Glu</td><td>GGA Gly</td><th scope=\"row\">A</th></tr>\n<tr><td>GUG Val</td><td>GCG Ala</td><td>GAG Glu</td><td>GGG Gly</td><th scope=\"row\">G</th></tr>\n</tbody>\n</table></div>",
