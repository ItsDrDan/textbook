ock;margin:0;width:100%;height:auto;max-width:900px\" loading=\"lazy\" /><img class=\"fig-w720\" src=\"https://itsdrdan.github.io/textbook/figures/print/fa_synthesis-v2-2.svg?v=20261113t\" alt=\"\" style=\"display:block;margin:0;width:100%;height:auto;max-width:900px\" loading=\"lazy\" /></a></div>",
