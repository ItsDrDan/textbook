  }
 ],
 "597188": [
  {
   "old": "<img class=\"internal\" alt=\"The three stages of catabolism. Stage 1, digestion: polysaccharides become monosaccharides, fats become fatty acids and glycerol, proteins become amino acids. Stage 2: glucose is split by glycolysis to pyruvate, and pyruvate, fatty acids and amino acids are all converted to acetyl CoA, with a small amount of ATP and NADH. Stage 3: acetyl CoA is oxidized in the citric acid cycle, giving carbon dioxide, NADH and FADH2; electron transport and oxidative phosphorylation then use oxygen to make most of the ATP.\" width=\"760\" style=\"max-width:100%;height:auto;\" src=\"/@api/deki/files/512605/fig-p597188-1.svg\" fileid=\"512605\" />",
   "new": "<img alt=\"The three stages of catabolism. Stage 1, digestion: polysaccharides become monosaccharides, fats become fatty acids and glycerol, proteins become amino acids. Stage 2: glucose is split by glycolysis to pyruvate, and pyruvate, fatty acids and amino acids are all converted to acetyl CoA, with a small amount of ATP and NADH. Stage 3: acetyl CoA is oxidized in the citric acid cycle, giving carbon dioxide, NADH and FADH2; electron transport and oxidative phosphorylation then use oxygen to make most of the ATP.\" width=\"760\" style=\"display:block;margin:0;max-width:100%;height:auto;\" src=\"https://itsdrdan.github.io/textbook/figures/print/fig-p597188-1-1.svg\" /><img alt=\"\" width=\"760\" style=\"display:block;margin:0;max-width:100%;height:auto;\" src=\"https://itsdrdan.github.io/textbook/figures/print/fig-p597188-1-2.svg\" />",
   "count": 1,
